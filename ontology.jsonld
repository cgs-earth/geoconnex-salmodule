{
  "@context": {
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "sh": "http://www.w3.org/ns/shacl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "salmodule": "https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#"
  },
  "@graph": [
    {
      "@id": ".",
      "@type": "owl:Ontology",
      "rdfs:label": "Geoconnex JSON-LD harvester",
      "rdfs:comment": "Streams the jsonld column out of the GeoParquet files listed in the Geoconnex STAC catalog (https://storage.googleapis.com/harvest-geoconnex-us/stac/catalog.json), one feature per output line."
    },
    {
      "@id": "JsonLdHarvester",
      "@type": "owl:Class",
      "rdfs:label": "JSON-LD harvester",
      "rdfs:comment": "Reads the Geoconnex STAC catalog, streams the jsonld column of each matching sitemap's GeoParquet asset over HTTP range requests, and writes every feature's JSON-LD node to stdout unchanged.",
      "rdfs:subClassOf": { "@id": "salmodule:NodeProducer" },
      "salmodule:taskShape": {
        "@type": "sh:NodeShape",
        "sh:targetClass": { "@id": "JsonLdHarvester" },
        "sh:property": [
          {
            "sh:path": { "@id": "includeSitemaps" },
            "sh:datatype": { "@id": "xsd:string" },
            "sh:name": "includeSitemaps"
          },
          {
            "sh:path": { "@id": "excludeSitemaps" },
            "sh:datatype": { "@id": "xsd:string" },
            "sh:name": "excludeSitemaps"
          }
        ]
      }
    },
    {
      "@id": "includeSitemaps",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "include sitemaps",
      "rdfs:comment": "A Geoconnex sitemap_id (e.g. 'ref:states') to harvest. Repeatable. When set, only these sitemaps are harvested and excludeSitemaps is ignored.",
      "rdfs:domain": { "@id": "JsonLdHarvester" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "excludeSitemaps",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "exclude sitemaps",
      "rdfs:comment": "A Geoconnex sitemap_id (e.g. 'wwdh:usbr:rise') to skip. Repeatable. Ignored when includeSitemaps is set.",
      "rdfs:domain": { "@id": "JsonLdHarvester" },
      "rdfs:range": { "@id": "xsd:string" }
    }
  ]
}
